{
  "dataset": "COCO128 (first 128 images of COCO train2017)",
  "dataset_url": "https://github.com/ultralytics/assets/releases/download/v0.0.0/coco128.zip",
  "n_images": 128,
  "weights": "yolov8n.pt",
  "device": "cpu",
  "classes": {
    "0": "person",
    "1": "bicycle",
    "2": "car",
    "3": "motorcycle",
    "5": "bus",
    "7": "truck",
    "9": "traffic light"
  },
  "conf_thres": 0.25,
  "iou_match": 0.5,
  "imgsz": 640,
  "saturated_level": 250,
  "motion_blur_kernels_px": [
    5,
    9,
    15,
    25
  ],
  "exposure_gains": [
    1.5,
    2.5,
    4.0
  ],
  "python": "3.12.10",
  "torch": "2.14.1+cpu",
  "ultralytics": "8.4.173",
  "opencv": "5.0.0",
  "numpy": "2.5.2",
  "cpu": "Intel64 Family 6 Model 126 Stepping 5, GenuineIntel"
}